# ============================================================
# Autonomous Business Manager
# Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=Autonomous Business Manager
APP_ENV=development
DEBUG=false
TIMEZONE=UTC
DOMAIN=example.com

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Production: use an Argon2id hash generated by the application's
# password tooling. Do not put the plaintext administrator password here.
ADMIN_PASSWORD_HASH=

# Development/migration fallback only. Leave empty in production.
ADMIN_PASSWORD=

# كلمة مرور لوحة الأسرار/API الداخلية.
API_PANEL_PASSWORD=CHANGE_THIS_TO_ANOTHER_STRONG_PASSWORD

# سر الجلسات.
# استخدم قيمة عشوائية طويلة ولا تشاركها مع أي شخص.
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# سر حماية CSRF — مطلوب في production ويجب أن يكون عشوائياً بطول 32 حرفاً على الأقل.
CSRF_SECRET=CHANGE_THIS_TO_A_RANDOM_CSRF_SECRET_32_CHARS_MINIMUM

# ------------------------------------------------------------
# Encryption
# ------------------------------------------------------------

# مفتاح Fernet لتشفير الأسرار المخزنة في قاعدة البيانات.
#
# يجب أن يكون مفتاح Fernet صالحًا.
# لا تضعه داخل GitHub ولا ترسله في المحادثة.
#
# مثال شكلي فقط:
# ENCRYPTION_KEY=YOUR_FERNET_KEY_HERE

ENCRYPTION_KEY=

# ------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------

# ضع مفتاح OpenAI محليًا في ملف .env فقط.
# لا ترفعه إلى GitHub.
OPENAI_API_KEY=

# النموذج المستخدم من Agent.
OPENAI_MODEL=gpt-5.6

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_PATH=data/business_manager.db

# ------------------------------------------------------------
# Uploads
# ------------------------------------------------------------

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# ------------------------------------------------------------
# Browser Automation
# ------------------------------------------------------------

BROWSER_PROFILE_DIR=browser_profiles

# true = بدون نافذة متصفح
# false = إظهار المتصفح أثناء التطوير
BROWSER_HEADLESS=true

BROWSER_TIMEOUT=30000

# ------------------------------------------------------------
# Internet Connectivity
# ------------------------------------------------------------

CONNECTIVITY_CHECK_URL=https://www.google.com/generate_204
CONNECTIVITY_INTERVAL=15

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------

# اتركها فارغة إذا لم تستخدم Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# WhatsApp Business API
# ------------------------------------------------------------

# استخدم WhatsApp Business API الرسمي أو مزودًا رسميًا.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=

# ============================================================
# SECURITY NOTES
# ============================================================
#
# 1. هذا الملف مثال فقط.
# 2. انسخه إلى .env عند إعداد المشروع.
# 3. لا ترفع .env إلى GitHub.
# 4. لا تضع OPENAI_API_KEY داخل الكود.
# 5. لا تضع Telegram/WhatsApp tokens داخل الكود.
# 6. لا تشارك ENCRYPTION_KEY.
# 7. لا تشارك SESSION_SECRET أو CSRF_SECRET.
# 8. في production يجب استخدام ADMIN_PASSWORD_HASH (Argon2id)
#    بدلاً من كلمة مرور الإدارة النصية.
# 9. في production يجب أيضاً ضبط ENCRYPTION_KEY وCSRF_SECRET
#    وSESSION_SECRET بقيم عشوائية قوية.
# 10. تغيير ENCRYPTION_KEY بعد تخزين أسرار مشفرة
#     سيجعل الأسرار القديمة غير قابلة لفك التشفير.
#
# ============================================================
